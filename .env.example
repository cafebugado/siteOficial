# Resend - Serviço de envio de emails
# Crie sua chave em: https://resend.com/api-keys
RESEND_API_KEY=sua_chave_aqui

# Email de destino (quem vai receber as mensagens do formulário)
CONTACT_TO_EMAIL=seu_email@gmail.com

# Remetente exibido no email (precisa ser um domínio verificado no Resend)
# Em desenvolvimento pode usar: onboarding@resend.dev
CONTACT_FROM_EMAIL=Nome do Projeto <onboarding@resend.dev>

# Supabase - Eventos (projeto agendas_eventos)
# Solicitar ao administrador do projeto
VITE_SUPABASE_URL=sua_url_aqui
VITE_SUPABASE_ANON_KEY=sua_chave_anon_aqui

# URL base da plataforma de eventos do Café Bugado
VITE_EVENTOS_BASE_URL=https://eventos.cafebugado.com.br

# Supabase - Comunidade (projeto community_members)
# Solicitar ao administrador do projeto
VITE_SUPABASE_COMMUNITY_URL=sua_url_aqui
VITE_SUPABASE_COMMUNITY_ANON_KEY=sua_chave_anon_aqui
